# ── SUPABASE CONFIGURATION ──────────────────────────────────────────────────
# Frontend public keys (safe to expose to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend service role keys (NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── DATABASE ───────────────────────────────────────────────────────────────
# PostgreSQL connection string
# For local dev: postgresql://localhost:5432/zenith_atelier
# For production (Render/Supabase DB): Use the DATABASE_URL provided by Render or Supabase
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── JWT AUTHENTICATION ──────────────────────────────────────────────────────
# Secret key for signing JWT tokens - use a long random string
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ── EMAIL SERVICE (NODEMAILER) ──────────────────────────────────────────────
# Gmail or other email provider settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ── ADMIN & WHATSAPP ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
WHATSAPP_NUMBER=your-destination-number
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token

# ── APPLICATION SETTINGS ───────────────────────────────────────────────────
# Client origin for CORS (where frontend is hosted)
CLIENT_ORIGIN=http://localhost:5173

# Server port
PORT=3000

# Environment: development, test, production
NODE_ENV=development
